{
  "name": "dsh-mcp-session",
  "version": "0.1.0",
  "description": "Session-level MCP visibility for DeepSeek Harness: MCP tools stay hidden (zero token cost) until a keyword in the current turn reveals them, they are pinned for the session (several at once), or they are reached through the mcp_call proxy. Each agent — subagents included — acquires servers on its own, so a scheduling parent never needs to know a server exists.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "lazy-loading",
    "token-savings",
    "session",
    "visibility"
  ],
  "license": "MIT",
  "author": "allenlogo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllenLogo/dsh-mcp-session.git"
  },
  "homepage": "https://github.com/AllenLogo/dsh-mcp-session#readme",
  "bugs": {
    "url": "https://github.com/AllenLogo/dsh-mcp-session/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
